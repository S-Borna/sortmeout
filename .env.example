# SortMeOut desktop app keys
# Copy to ~/.config/sortmeout/.env for local app usage.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cloudflare Worker secrets (set with `wrangler secret put`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LICENSE_SIGNING_KEY=
DISCORD_WEBHOOK_URL=

# Cloudflare Worker vars (set in wrangler.toml [vars])
STRIPE_PRICE_ID=
CORS_ORIGIN=https://sortmeout.saidborna.com
OWNER_EMAIL=
FROM_DOMAIN=sortmeout.saidborna.com
